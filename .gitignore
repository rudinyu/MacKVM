# SwiftPM build products. The glob also covers ad-hoc copies such as
# .build-before-review/ that reviews and bisects leave behind.
.build*/
.swiftpm/
**/.build/

# Release artifacts produced by macOS and Windows build scripts.
/dist/
**/dist/
build/
**/build/
*.app/
*.dmg
*.dmg.sha256
ddc-diagnostic-*

# Xcode and IDE per-user state.
xcuserdata/
*.xcuserstate
.vs/

# .NET build outputs (keep source projects and checked-in tests only).
**/bin/
**/obj/

# macOS Finder metadata.
.DS_Store

# Local agent workflow, instruction, and review files. These stay on the
# machine and must never reach GitHub.
.claude/
.codex/
CLAUDE.md
AGENTS.md
CODEX_*.md

# Never add local credentials or certificate material to a commit.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt

.build/
.swiftpm/
.DS_Store
CODEX_CLAUDE_REVIEW.md
CODEX_REVIEW.md
CODEX_FEATURE_AUDIT.md

# Release artifacts from both macOS and Windows builds. Keep the root rule
# explicit for MacKVM output and the recursive rule for Windows companion
# packages or any future platform-specific staging directory.
/dist/
**/dist/

# macOS/Xcode and SwiftPM build products. App bundles, disk images, checksums,
# and standalone diagnostics are generated under dist/ but remain ignored even
# if a local script is changed to emit them elsewhere.
**/.build/
build/
**/build/
# Ignore macOS application bundles at any depth. The Windows source project is
# named WindowsKVM.Desktop so Finder does not mistake its directory for a .app.
*.app/
*.dmg
*.dmg.sha256
ddc-diagnostic-*

# Windows/.NET build outputs.
**/bin/
**/obj/
.vs/

# Local AI-agent configuration is intentionally kept outside the public repo.
.codex/
.claude/
.claude/.claude.json
.claude/settings.local.json
.claude/*.lock
.claude/projects/
.claude/sessions/
.claude/cache/
.claude/telemetry/

# Never add local credentials or certificate material to a commit.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
